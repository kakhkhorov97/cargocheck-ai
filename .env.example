PORT=3001
APP_ORIGIN=http://localhost:4173
# Required for registration and email verification. Use the exact trusted frontend
# origin, without a trailing slash. Production APP_ORIGIN must use HTTPS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=verify@example.com
# SMTP_SECURE=true uses implicit TLS, commonly on port 465.
# SMTP_SECURE=false requires STARTTLS. TLS certificate validation stays enabled.
# Optional; omit both for the persistent local development store and in-process jobs.
DATABASE_URL=postgresql://kakhkhorov@localhost:5432/cargocheck
# REDIS_URL=redis://localhost:6379
# Optional cloud extraction. Uploaded documents are sent to Google only in this mode.
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Default: local PDF text extraction + Tesseract OCR, then explicit template parsing.
EXTRACTION_PROVIDER=local
DATA_DIR=../../data
# Set true only behind HTTPS in production.
COOKIE_SECURE=false
